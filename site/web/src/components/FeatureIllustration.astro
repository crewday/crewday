---
interface Props {
  variant: "agent" | "operations" | "selfHost";
}

const { variant } = Astro.props;
---

<div class:list={["feature-illustration", `feature-illustration--${variant}`]} aria-hidden="true">
  {
    variant === "agent" && (
      <svg viewBox="0 0 320 220" role="img">
        <path class="feature-illustration__wash" d="M42 34h236v152H42z" />
        <path class="feature-illustration__line" d="M78 72h164M78 108h92M78 144h124" />
        <path class="feature-illustration__accent" d="M232 72l20 18-20 18M96 170l-22-18 22-18" />
        <circle class="feature-illustration__dot" cx="232" cy="144" r="14" />
      </svg>
    )
  }
  {
    variant === "operations" && (
      <svg viewBox="0 0 320 220" role="img">
        <path class="feature-illustration__wash" d="M56 46h86v58H56zM178 46h86v58h-86zM56 134h86v58H56zM178 134h86v58h-86z" />
        <path class="feature-illustration__line" d="M142 75h36M99 104v30M221 104v30M142 163h36" />
        <circle class="feature-illustration__dot" cx="99" cy="75" r="12" />
        <circle class="feature-illustration__dot" cx="221" cy="163" r="12" />
      </svg>
    )
  }
  {
    variant === "selfHost" && (
      <svg viewBox="0 0 320 220" role="img">
        <path class="feature-illustration__wash" d="M88 42h144v136H88z" />
        <path class="feature-illustration__line" d="M116 76h88M116 106h72M116 136h88" />
        <path class="feature-illustration__accent" d="M232 96h34v74H54V96h34" />
        <circle class="feature-illustration__dot" cx="216" cy="136" r="10" />
      </svg>
    )
  }
</div>
