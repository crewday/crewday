---
import { siteCopy } from "@/content/en/site";
---

<footer class="site-footer" aria-label={siteCopy.footer.label}>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a class="site-footer__mark" href="/">{siteCopy.brand}</a>
      <p>{siteCopy.footer.summary}</p>
    </div>

    <nav class="site-footer__nav" aria-label={siteCopy.footer.label}>
      {
        siteCopy.footer.columns.map((column) => (
          <section class="site-footer__column" aria-labelledby={`footer-${column.heading.toLowerCase()}`}>
            <h2 id={`footer-${column.heading.toLowerCase()}`}>{column.heading}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>
  </div>
</footer>
