---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/globals.css";
import type { SiteLink } from "@/content/en/site";
import { siteCopy } from "@/content/en/site";
import LandingImprint from "./LandingImprint.astro";
import LandingMasthead from "./LandingMasthead.astro";

interface Props {
  title: string;
  description: string;
  navLinks?: readonly SiteLink[];
  navAriaLabel?: string;
}

const {
  title,
  description,
  navAriaLabel = siteCopy.header.navLabel,
  navLinks = siteCopy.header.navLinks,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="site-surface">
    <a class="skip-link" href="#main">{siteCopy.skipLink}</a>
    <div class="landing-grain" aria-hidden="true"></div>
    <main id="main" class="landing-page">
      <div class="landing-frame">
        <LandingMasthead navLinks={navLinks} navAriaLabel={navAriaLabel} />
        <hr class="landing-rule" />
      </div>
      <slot />
      <div class="landing-frame">
        <LandingImprint />
      </div>
    </main>
  </body>
</html>
