---
import { House } from "@/icons";
import { appLinks, siteCopy } from "@/content/en/site";

const normalizePath = (path: string) => (path === "/" ? path : path.replace(/\/$/u, ""));
const path = normalizePath(Astro.url.pathname);
---

<a class="skip-link" href="#main">{siteCopy.skipLink}</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={siteCopy.brand}>
      <House size={22} strokeWidth={1.75} aria-hidden="true" />
      <span>{siteCopy.brand}</span>
    </a>

    <nav class="site-header__nav" aria-label={siteCopy.header.navLabel}>
      {
        siteCopy.header.navLinks.map((link) => {
          const isActive = path === normalizePath(link.href);

          return (
            <a
              class:list={["site-header__nav-link", { "site-header__nav-link--active": isActive }]}
              href={link.href}
              aria-current={isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <nav class="site-header__auth" aria-label={siteCopy.header.accountLabel}>
      <a class="site-header__login" href={appLinks.login.href}>{appLinks.login.label}</a>
      <a class="site-header__signup" href={appLinks.signup.href}>{appLinks.signup.label}</a>
    </nav>
  </div>
</header>
