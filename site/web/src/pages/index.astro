---
import FeatureIllustration from "@/components/FeatureIllustration.astro";
import SiteShell from "@/components/SiteShell.astro";
import { homeCopy } from "@/content/en/home";
import { ScenarioPicker } from "@/islands/ScenarioPicker";
import { ArrowRight, Sparkles } from "@/icons";

const description = homeCopy.description;
---

<SiteShell title={homeCopy.title} description={description}>
  <main id="main" class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="eyebrow">{homeCopy.hero.eyebrow}</p>
        <h1 id="home-title">{homeCopy.hero.headline}</h1>
        <p class="home-hero__summary">{homeCopy.hero.subhead}</p>
      </div>

      <div class="action-row">
        <a class="button button--primary" href={homeCopy.hero.primaryCta.href}>
          <Sparkles size={18} strokeWidth={1.75} aria-hidden="true" />
          <span>{homeCopy.hero.primaryCta.label}</span>
        </a>
        <a class="button button--secondary" href={homeCopy.hero.secondaryCta.href}>
          <span>{homeCopy.hero.secondaryCta.label}</span>
          <ArrowRight size={18} strokeWidth={1.75} aria-hidden="true" />
        </a>
      </div>
    </section>

    <section class="section-band home-features" aria-labelledby="features-title">
      <div class="section-heading">
        <p class="eyebrow">{homeCopy.featureIntro.eyebrow}</p>
        <h2 id="features-title">{homeCopy.featureIntro.heading}</h2>
      </div>

      <div class="feature-band-list">
        {
          homeCopy.features.map((feature) => (
            <article class="feature-band">
              <div class="feature-band__copy">
                <p class="eyebrow">{feature.eyebrow}</p>
                <h3>{feature.heading}</h3>
                <p>{feature.body}</p>
              </div>
              <FeatureIllustration variant={feature.illustration} />
            </article>
          ))
        }
      </div>
    </section>

    <section id="try-it" class="try-it-section" aria-label={homeCopy.tryIt.label}>
      <ScenarioPicker client:load />
    </section>
  </main>
</SiteShell>
