# npm 11+ enforces peer-dep ranges strictly. `vite-plugin-pwa@1.2.0`
# peers `vite@^3..^7`, but the app toolchain declares
# `vite@^8.0.8` + `@vitejs/plugin-react@^6.0.1` (which peers
# `vite@^8`). Without this flag, `npm ci` aborts with ERESOLVE before
# it ever writes node_modules. Root fix is to wait for a
# `vite-plugin-pwa` release that peers vite 8 or replace the PWA build
# plugin; until then this file keeps the scaffold installable.
legacy-peer-deps=true
save-exact=true
engine-strict=true
min-release-age=7
