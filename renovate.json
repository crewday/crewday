{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Etc/UTC",
  "schedule": ["* 12 * * 5"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 17 * * 5"]
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
